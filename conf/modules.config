/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

// Every Mondrian image is built from one molonc/mondrian_utils release and
// shares its tag (the release tag with "+" replaced by "-").
params.container_version = "v0.1.0-molonc.1"

if (params.mode == "qc") {
    process {
        withLabel: 'process_high' { container = "ghcr.io/molonc/mondrian_utils/hmmcopy:${params.container_version}" }
        withLabel: 'process_med' { container = "ghcr.io/molonc/mondrian_utils/hmmcopy:${params.container_version}" }
        withLabel: 'process_low' { container = "ghcr.io/molonc/mondrian_utils/hmmcopy:${params.container_version}" }
        withName: 'ALIGN|BAMMERGECELLS' { container = "ghcr.io/molonc/mondrian_utils/alignment:${params.container_version}" }
        withName: 'HTMLREPORT|PLOTHEATMAP|ADDCLUSTERINGORDER|CONCATREADS|CONCATSEGMENTS|CONCATALIGNMETRICS|CONCATGCMETRICS|CONCATPARAMS|HMMTAR' {
            publishDir = [
                path: { "${params.output_dir}/" },
                mode: 'copy'
            ]
        }
        withName: 'BAMMERGECELLS|RECOPYMETADATA|ALIGNTAR' {
            publishDir = [
                path: { "${params.output_dir}/" },
                mode: 'copy'
            ]
        }
    }
}

if (params.mode=="counthaps") {
    process {
        withLabel: 'process_high' { container = "ghcr.io/molonc/mondrian_utils/haplotype_calling:${params.container_version}" }
        withLabel: 'process_med' { container = "ghcr.io/molonc/mondrian_utils/haplotype_calling:${params.container_version}" }
        withLabel: 'process_low' { container = "ghcr.io/molonc/mondrian_utils/haplotype_calling:${params.container_version}" }
        withName: 'CONCATALLELECOUNTS' {
            container = "ghcr.io/molonc/mondrian_utils/haplotype_calling:${params.container_version}"
            publishDir = [
                path: { "${params.output_dir}/" },
                mode: 'copy'
            ]
        }
    }
}


if (params.mode=="inferhaps") {
    process {
        withLabel: 'process_high' { container = "ghcr.io/molonc/mondrian_utils/haplotype_calling:${params.container_version}" }
        withLabel: 'process_med' { container = "ghcr.io/molonc/mondrian_utils/haplotype_calling:${params.container_version}" }
        withLabel: 'process_low' { container = "ghcr.io/molonc/mondrian_utils/haplotype_calling:${params.container_version}" }
        withName: 'CONCATCSV|INFERHAPSMETADATA' {
            publishDir = [
                path: { "${params.output_dir}/" },
                mode: 'copy'
            ]
        }
    }
}


if (params.mode=="snv_genotyping") {
    process {
        withLabel: 'process_high' { container = "ghcr.io/molonc/mondrian_utils/variant_calling:${params.container_version}" }
        withLabel: 'process_med' { container = "ghcr.io/molonc/mondrian_utils/variant_calling:${params.container_version}" }
        withLabel: 'process_low' { container = "ghcr.io/molonc/mondrian_utils/variant_calling:${params.container_version}" }
        withName: 'REGENERATEVARTRIXOUTPUTS|CONCATCSV|SNVGENOTYPINGMETADATA|PYSAMGENOTYPER' {
            publishDir = [
                path: { "${params.output_dir}/" },
                mode: 'copy'
            ]
        }
    }
}


if (params.mode=="normalizer") {
    process {
        withLabel: 'process_high' { container = "ghcr.io/molonc/mondrian_utils/alignment:${params.container_version}" }
        withLabel: 'process_med' { container = "ghcr.io/molonc/mondrian_utils/alignment:${params.container_version}" }
        withLabel: 'process_low' { container = "ghcr.io/molonc/mondrian_utils/alignment:${params.container_version}" }
        withName: 'NORMALIZERQCMETADATA|NORMALIZERMETADATA|SEPARATETUMORANDNORMALBAMS|ANEUPLOIDYHEATMAP|IDENTIFYNORMALS' {
            publishDir = [
                path: { "${params.output_dir}/" },
                mode: 'copy'
            ]
        }
    }
}



if (params.mode=="breakpoint") {
    process {
        withLabel: 'process_high' { container = "ghcr.io/molonc/mondrian_utils/breakpoint_calling:${params.container_version}" }
        withLabel: 'process_med' { container = "ghcr.io/molonc/mondrian_utils/breakpoint_calling:${params.container_version}" }
        withLabel: 'process_low' { container = "ghcr.io/molonc/mondrian_utils/breakpoint_calling:${params.container_version}" }
        withName: 'BREAKPOINTMETADATA|EXTRACTSOMATIC|EXTRACTCOUNTS|DESTRUCT_TO_VCF|LUMPYEXPRESS|GRIDSS|SVABA|CSVERVEREMOVEDUPLICATES' {
            publishDir = [
                path: { "${params.output_dir}/" },
                mode: 'copy'
            ]
        }
        withName: 'DESTRUCT' {
            publishDir = [
                path: { "${params.output_dir}/" },
                mode: 'copy',
                pattern: '*read_table.csv*'
            ]
        }
    }
}


if (params.mode=="variant") {
    process {
        withLabel: 'process_high' { container = "ghcr.io/molonc/mondrian_utils/variant_calling:${params.container_version}" }
        withLabel: 'process_med' { container = "ghcr.io/molonc/mondrian_utils/variant_calling:${params.container_version}" }
        withLabel: 'process_low' { container = "ghcr.io/molonc/mondrian_utils/variant_calling:${params.container_version}" }
        withName: 'VCF2MAF|UPDATEMAFCOUNTS|VARIANTCONSENSUS|REHEADER_MUSEQ|FILTERALIGNMENTARTIFACTS|REHEADER_STRELKA_SNV|REHEADER_STRELKA_INDEL|VARIANTMETADATA' {
            publishDir = [
                path: { "${params.output_dir}/" },
                mode: 'copy',
                pattern: '*'
            ]
        }

    }
}